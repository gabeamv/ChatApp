<UserControl x:Class="ChatAppServer.Views.ServerConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ChatAppServer.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Row="0" Grid.Column="0" Header="Connected Users" Width="375" HorizontalAlignment="Left">
            <ListView ItemsSource="{Binding Users}" ScrollViewer.CanContentScroll="True" HorizontalAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="Username" Text="{Binding}"/>
                            
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>

        <Grid Grid.Row="1" Width="400" HorizontalAlignment="Left">
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0, 10, 0, 0">
                
                <Button Content="Start Server" Height="25" Width="100" Command="{Binding StartServerCommand}"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Width="375" Header="History" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0, 0, 0, 35">
            <ListView ItemsSource="{Binding History}" ScrollViewer.CanContentScroll="True" HorizontalAlignment="Stretch" IsEnabled="False" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}: {1}">
                                    <Binding Path="Sender"/>
                                    <Binding Path="Message"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal">
            <Button Margin="0, 5, 5, 5" Width="50" Height="25" Content="Send"/>
            <TextBox Name="MessageTextBox" Height="20" Width="325" HorizontalAlignment="Center" TextWrapping="Wrap">
                <TextBox.InputBindings>
                   
                </TextBox.InputBindings>
            </TextBox>
        </StackPanel>



    </Grid>
</UserControl>
