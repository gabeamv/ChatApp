<Window x:Class="ChatAppServer.IpPortWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatAppServer"
        mc:Ignorable="d"
        Title="IP and Port" Height="300" Width="250">
    <Grid>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 0, 0, 10">
                <TextBlock Text="IP Address: "/>
                <TextBox Width="100" Text="{Binding IP, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 0, 0, 10">
                <TextBlock Text="Port: "/>
                <TextBox Width="100" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <Button Content="Confirm" Width="75" Command="{Binding ConfirmCommand}"/>
        </StackPanel>
    </Grid>
</Window>
